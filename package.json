{
  "name": "hisstory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HISSTORY: a retro Snake game with a story mode, rivals and coil-to-conquer boss fights.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
